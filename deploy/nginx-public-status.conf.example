# No Bars Mesh Bridge public status reverse proxy example
#
# Goal: publish ONLY read-only operational endpoints.
# Keep the NiceGUI dashboard on port 9092 private behind firewall/VPN/Access.
#
# Example public hostname: bridge.nobarsclub.com

server {
    listen 443 ssl http2;
    server_name bridge.nobarsclub.com;

    # TLS directives are intentionally omitted here.
    # Use your existing certificate/Cloudflare origin configuration.

    location = /api/status {
        proxy_pass http://127.0.0.1:9092/api/status;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_hide_header Server;
    }

    location = /healthz {
        proxy_pass http://127.0.0.1:9092/healthz;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_hide_header Server;
    }

    # Do not expose the NiceGUI admin dashboard on this public host.
    location / {
        return 404;
    }
}
